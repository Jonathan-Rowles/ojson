package generate

import "core:fmt"
import "core:strings"

generate_code :: proc(
	structs: []Struct_Info,
	package_name: string,
	allocator := context.allocator,
) -> string {
	sb := strings.builder_make(allocator)

	strings.write_string(&sb, "// Code generated by json_odin generator. DO NOT EDIT.\n")
	strings.write_string(&sb, "package ")
	strings.write_string(&sb, package_name)
	strings.write_string(&sb, "\n\n")
	strings.write_string(&sb, "import \"core:fmt\"\n\n")

	for info in structs {
		generate_unmarshal_proc(&sb, info)
		strings.write_string(&sb, "\n")
	}

	return strings.to_string(sb)
}

generate_unmarshal_proc :: proc(sb: ^strings.Builder, info: Struct_Info) {
	lower_name := to_snake_case(info.name)

	fmt.sbprintf(
		sb,
		"unmarshal_%s :: proc(r: ^Reader, prefix: string = \"\") -> (result: %s, err: Error) {{\n",
		lower_name,
		info.name,
	)
	strings.write_string(sb, "\tp := len(prefix) > 0 ? fmt.tprintf(\"%s.\", prefix) : \"\"\n\n")

	for field in info.fields {
		generate_field_read(sb, field)
	}

	strings.write_string(sb, "\treturn\n")
	strings.write_string(sb, "}\n")
}

generate_field_read :: proc(sb: ^strings.Builder, field: Field_Info) {
	key_expr := fmt.tprintf("fmt.tprintf(\"%%s%%s\", p, \"%s\")", field.json_name)

	switch field.type_kind {
	case .String:
		fmt.sbprintf(sb, "\tresult.%s, err = read_string(r, %s)\n", field.odin_name, key_expr)
		strings.write_string(sb, "\tif err != .OK && err != .Key_Not_Found do return\n\n")

	case .Int:
		fmt.sbprintf(sb, "\tresult.%s, err = read_int(r, %s)\n", field.odin_name, key_expr)
		strings.write_string(sb, "\tif err != .OK && err != .Key_Not_Found do return\n\n")

	case .I64:
		fmt.sbprintf(sb, "\tresult.%s, err = read_i64(r, %s)\n", field.odin_name, key_expr)
		strings.write_string(sb, "\tif err != .OK && err != .Key_Not_Found do return\n\n")

	case .F64:
		fmt.sbprintf(sb, "\tresult.%s, err = read_f64(r, %s)\n", field.odin_name, key_expr)
		strings.write_string(sb, "\tif err != .OK && err != .Key_Not_Found do return\n\n")

	case .Bool:
		fmt.sbprintf(sb, "\tresult.%s, err = read_bool(r, %s)\n", field.odin_name, key_expr)
		strings.write_string(sb, "\tif err != .OK && err != .Key_Not_Found do return\n\n")

	case .I8, .I16, .I32:
		fmt.sbprintf(sb, "\t{{\n")
		fmt.sbprintf(sb, "\t\tval: i64\n")
		fmt.sbprintf(sb, "\t\tval, err = read_i64(r, %s)\n", key_expr)
		strings.write_string(sb, "\t\tif err != .OK && err != .Key_Not_Found do return\n")
		fmt.sbprintf(
			sb,
			"\t\tif err == .OK do result.%s = %s(val)\n",
			field.odin_name,
			field.type_name,
		)
		fmt.sbprintf(sb, "\t}}\n\n")

	case .U8, .U16, .U32, .U64, .Uint:
		fmt.sbprintf(sb, "\t{{\n")
		fmt.sbprintf(sb, "\t\tval: i64\n")
		fmt.sbprintf(sb, "\t\tval, err = read_i64(r, %s)\n", key_expr)
		strings.write_string(sb, "\t\tif err != .OK && err != .Key_Not_Found do return\n")
		fmt.sbprintf(
			sb,
			"\t\tif err == .OK do result.%s = %s(val)\n",
			field.odin_name,
			field.type_name,
		)
		fmt.sbprintf(sb, "\t}}\n\n")

	case .F16, .F32:
		fmt.sbprintf(sb, "\t{{\n")
		fmt.sbprintf(sb, "\t\tval: f64\n")
		fmt.sbprintf(sb, "\t\tval, err = read_f64(r, %s)\n", key_expr)
		strings.write_string(sb, "\t\tif err != .OK && err != .Key_Not_Found do return\n")
		fmt.sbprintf(
			sb,
			"\t\tif err == .OK do result.%s = %s(val)\n",
			field.odin_name,
			field.type_name,
		)
		fmt.sbprintf(sb, "\t}}\n\n")

	case .Enum:
		fmt.sbprintf(sb, "\t{{\n")
		fmt.sbprintf(sb, "\t\tval: int\n")
		fmt.sbprintf(sb, "\t\tval, err = read_int(r, %s)\n", key_expr)
		strings.write_string(sb, "\t\tif err != .OK && err != .Key_Not_Found do return\n")
		fmt.sbprintf(
			sb,
			"\t\tif err == .OK do result.%s = %s(val)\n",
			field.odin_name,
			field.type_name,
		)
		fmt.sbprintf(sb, "\t}}\n\n")

	case .Distinct:
		fmt.sbprintf(sb, "\t{{\n")
		fmt.sbprintf(sb, "\t\tval: int\n")
		fmt.sbprintf(sb, "\t\tval, err = read_int(r, %s)\n", key_expr)
		strings.write_string(sb, "\t\tif err != .OK && err != .Key_Not_Found do return\n")
		fmt.sbprintf(
			sb,
			"\t\tif err == .OK do result.%s = %s(val)\n",
			field.odin_name,
			field.type_name,
		)
		fmt.sbprintf(sb, "\t}}\n\n")

	case .Struct:
		nested_lower := to_snake_case(field.type_name)
		fmt.sbprintf(
			sb,
			"\tresult.%s, err = unmarshal_%s(r, %s)\n",
			field.odin_name,
			nested_lower,
			key_expr,
		)
		strings.write_string(sb, "\tif err != .OK && err != .Key_Not_Found do return\n\n")

	case .Array_Primitive:
		generate_array_primitive_read(sb, field)

	case .Array_Struct:
		generate_array_struct_read(sb, field)

	case .Dynamic_Primitive:
		generate_dynamic_primitive_read(sb, field)

	case .Dynamic_Struct:
		generate_dynamic_struct_read(sb, field)

	case .Unknown:
		fmt.sbprintf(sb, "\t// TODO: Unknown type for field %s\n\n", field.odin_name)
	}
}

generate_array_primitive_read :: proc(sb: ^strings.Builder, field: Field_Info) {
	key_expr := fmt.tprintf("fmt.tprintf(\"%%s%%s\", p, \"%s\")", field.json_name)

	fmt.sbprintf(sb, "\t{{\n")
	fmt.sbprintf(sb, "\t\tarray_key := %s\n", key_expr)
	fmt.sbprintf(sb, "\t\tarr_len, len_err := array_len(r, array_key)\n")
	fmt.sbprintf(sb, "\t\tif len_err == .OK {{\n")
	fmt.sbprintf(
		sb,
		"\t\t\tresult.%s = make([]%s, arr_len)\n",
		field.odin_name,
		field.element_type,
	)
	fmt.sbprintf(sb, "\t\t\tfor i in 0..<arr_len {{\n")

	switch field.element_type {
	case "string":
		fmt.sbprintf(
			sb,
			"\t\t\t\tresult.%s[i], err = read_string(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			field.odin_name,
		)
	case "int":
		fmt.sbprintf(
			sb,
			"\t\t\t\tresult.%s[i], err = read_int(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			field.odin_name,
		)
	case "i64":
		fmt.sbprintf(
			sb,
			"\t\t\t\tresult.%s[i], err = read_i64(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			field.odin_name,
		)
	case "f64":
		fmt.sbprintf(
			sb,
			"\t\t\t\tresult.%s[i], err = read_f64(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			field.odin_name,
		)
	case "bool":
		fmt.sbprintf(
			sb,
			"\t\t\t\tresult.%s[i], err = read_bool(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			field.odin_name,
		)
	case:
		if is_integer_type(field.element_type) {
			fmt.sbprintf(
				sb,
				"\t\t\t\tval, read_err := read_i64(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			)
			fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
			fmt.sbprintf(
				sb,
				"\t\t\t\tresult.%s[i] = %s(val)\n",
				field.odin_name,
				field.element_type,
			)
		} else if is_float_type(field.element_type) {
			fmt.sbprintf(
				sb,
				"\t\t\t\tval, read_err := read_f64(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			)
			fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
			fmt.sbprintf(
				sb,
				"\t\t\t\tresult.%s[i] = %s(val)\n",
				field.odin_name,
				field.element_type,
			)
		} else {
			fmt.sbprintf(sb, "\t\t\t\t// TODO: handle element type %s\n", field.element_type)
		}
	}

	fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
	fmt.sbprintf(sb, "\t\t\t}}\n")
	fmt.sbprintf(sb, "\t\t}}\n")
	fmt.sbprintf(sb, "\t}}\n\n")
}

generate_array_struct_read :: proc(sb: ^strings.Builder, field: Field_Info) {
	key_expr := fmt.tprintf("fmt.tprintf(\"%%s%%s\", p, \"%s\")", field.json_name)
	elem_lower := to_snake_case(field.element_type)

	fmt.sbprintf(sb, "\t{{\n")
	fmt.sbprintf(sb, "\t\tarray_key := %s\n", key_expr)
	fmt.sbprintf(sb, "\t\tarr_len, len_err := array_len(r, array_key)\n")
	fmt.sbprintf(sb, "\t\tif len_err == .OK {{\n")
	fmt.sbprintf(
		sb,
		"\t\t\tresult.%s = make([]%s, arr_len)\n",
		field.odin_name,
		field.element_type,
	)
	fmt.sbprintf(sb, "\t\t\tfor i in 0..<arr_len {{\n")
	fmt.sbprintf(
		sb,
		"\t\t\t\tresult.%s[i], err = unmarshal_%s(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
		field.odin_name,
		elem_lower,
	)
	fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
	fmt.sbprintf(sb, "\t\t\t}}\n")
	fmt.sbprintf(sb, "\t\t}}\n")
	fmt.sbprintf(sb, "\t}}\n\n")
}

generate_dynamic_primitive_read :: proc(sb: ^strings.Builder, field: Field_Info) {
	key_expr := fmt.tprintf("fmt.tprintf(\"%%s%%s\", p, \"%s\")", field.json_name)

	fmt.sbprintf(sb, "\t{{\n")
	fmt.sbprintf(sb, "\t\tarray_key := %s\n", key_expr)
	fmt.sbprintf(sb, "\t\tarr_len, len_err := array_len(r, array_key)\n")
	fmt.sbprintf(sb, "\t\tif len_err == .OK {{\n")
	fmt.sbprintf(
		sb,
		"\t\t\tresult.%s = make([dynamic]%s, 0, arr_len)\n",
		field.odin_name,
		field.element_type,
	)
	fmt.sbprintf(sb, "\t\t\tfor i in 0..<arr_len {{\n")

	switch field.element_type {
	case "string":
		fmt.sbprintf(
			sb,
			"\t\t\t\tval, read_err := read_string(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
		)
		fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
		fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
		fmt.sbprintf(sb, "\t\t\t\tappend(&result.%s, val)\n", field.odin_name)
	case "int":
		fmt.sbprintf(
			sb,
			"\t\t\t\tval, read_err := read_int(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
		)
		fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
		fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
		fmt.sbprintf(sb, "\t\t\t\tappend(&result.%s, val)\n", field.odin_name)
	case "i64":
		fmt.sbprintf(
			sb,
			"\t\t\t\tval, read_err := read_i64(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
		)
		fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
		fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
		fmt.sbprintf(sb, "\t\t\t\tappend(&result.%s, val)\n", field.odin_name)
	case "f64":
		fmt.sbprintf(
			sb,
			"\t\t\t\tval, read_err := read_f64(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
		)
		fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
		fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
		fmt.sbprintf(sb, "\t\t\t\tappend(&result.%s, val)\n", field.odin_name)
	case "bool":
		fmt.sbprintf(
			sb,
			"\t\t\t\tval, read_err := read_bool(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
		)
		fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
		fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
		fmt.sbprintf(sb, "\t\t\t\tappend(&result.%s, val)\n", field.odin_name)
	case:
		if is_integer_type(field.element_type) {
			fmt.sbprintf(
				sb,
				"\t\t\t\tval, read_err := read_i64(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			)
			fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
			fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
			fmt.sbprintf(
				sb,
				"\t\t\t\tappend(&result.%s, %s(val))\n",
				field.odin_name,
				field.element_type,
			)
		} else if is_float_type(field.element_type) {
			fmt.sbprintf(
				sb,
				"\t\t\t\tval, read_err := read_f64(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
			)
			fmt.sbprintf(sb, "\t\t\t\terr = read_err\n")
			fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
			fmt.sbprintf(
				sb,
				"\t\t\t\tappend(&result.%s, %s(val))\n",
				field.odin_name,
				field.element_type,
			)
		} else {
			fmt.sbprintf(sb, "\t\t\t\t// TODO: handle element type %s\n", field.element_type)
		}
	}

	fmt.sbprintf(sb, "\t\t\t}}\n")
	fmt.sbprintf(sb, "\t\t}}\n")
	fmt.sbprintf(sb, "\t}}\n\n")
}

generate_dynamic_struct_read :: proc(sb: ^strings.Builder, field: Field_Info) {
	key_expr := fmt.tprintf("fmt.tprintf(\"%%s%%s\", p, \"%s\")", field.json_name)
	elem_lower := to_snake_case(field.element_type)

	fmt.sbprintf(sb, "\t{{\n")
	fmt.sbprintf(sb, "\t\tarray_key := %s\n", key_expr)
	fmt.sbprintf(sb, "\t\tarr_len, len_err := array_len(r, array_key)\n")
	fmt.sbprintf(sb, "\t\tif len_err == .OK {{\n")
	fmt.sbprintf(
		sb,
		"\t\t\tresult.%s = make([dynamic]%s, 0, arr_len)\n",
		field.odin_name,
		field.element_type,
	)
	fmt.sbprintf(sb, "\t\t\tfor i in 0..<arr_len {{\n")
	fmt.sbprintf(
		sb,
		"\t\t\t\titem, item_err := unmarshal_%s(r, fmt.tprintf(\"%%s.%%d\", array_key, i))\n",
		elem_lower,
	)
	fmt.sbprintf(sb, "\t\t\t\terr = item_err\n")
	fmt.sbprintf(sb, "\t\t\t\tif err != .OK do return\n")
	fmt.sbprintf(sb, "\t\t\t\tappend(&result.%s, item)\n", field.odin_name)
	fmt.sbprintf(sb, "\t\t\t}}\n")
	fmt.sbprintf(sb, "\t\t}}\n")
	fmt.sbprintf(sb, "\t}}\n\n")
}

to_snake_case :: proc(s: string, allocator := context.allocator) -> string {
	if len(s) == 0 {
		return ""
	}

	sb := strings.builder_make(allocator)

	for i := 0; i < len(s); i += 1 {
		c := s[i]
		if c >= 'A' && c <= 'Z' {
			if i > 0 {
				strings.write_byte(&sb, '_')
			}
			strings.write_byte(&sb, c + 32)
		} else {
			strings.write_byte(&sb, c)
		}
	}

	return strings.to_string(sb)
}

is_integer_type :: proc(type_name: string) -> bool {
	switch type_name {
	case "i8", "i16", "i32", "i64", "int", "u8", "u16", "u32", "u64", "uint":
		return true
	}
	return false
}

is_float_type :: proc(type_name: string) -> bool {
	switch type_name {
	case "f16", "f32", "f64":
		return true
	}
	return false
}
